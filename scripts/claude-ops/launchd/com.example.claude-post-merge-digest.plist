<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.example.claude-post-merge-digest</string>
  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/python3</string>
    <string>~/.claude/scripts/post-merge-review-digest.py</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>~/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
  </dict>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key><integer>7</integer>
    <key>Minute</key><integer>45</integer>
  </dict>
  <key>StandardOutPath</key>
  <string>~/.claude/logs/com.example.claude-post-merge-digest.log</string>
  <key>StandardErrorPath</key>
  <string>~/.claude/logs/com.example.claude-post-merge-digest.log</string>
  <key>RunAtLoad</key><false/>
</dict>
</plist>
